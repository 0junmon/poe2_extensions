{
  "name": "poe2-translation-kr",
  "version": "1.0.0",
  "description": "Korean translation data and lookup helpers for Path of Exile 2 websites",
  "type": "module",
  "exports": "./index.js",
  "files": [
    "index.js",
    "translations/"
  ],
  "scripts": {
    "build:extension": "node scripts/build_chrome_extension.mjs",
    "build:trade-stats": "node scripts/build_trade_stats.mjs",
    "build:skill-lines": "node scripts/build_skill_lines.mjs",
    "build:csd": "node scripts/build_csd_lines.mjs",
    "build:flavour-text": "node scripts/build_flavour_text.mjs",
    "build:keyword-definitions": "node scripts/build_keyword_definitions.mjs",
    "build:game-names": "node scripts/build_game_names.mjs",
    "build:character-classes": "node scripts/build_character_classes.mjs",
    "build:translation-map": "python build_translation_map.py",
    "build:all": "node scripts/build_all.mjs",
    "build:unique-items": "node scripts/build_unique_items.mjs",
    "build:data-search": "node scripts/build_data_search_bundle.mjs",
    "verify:data": "node scripts/verify_translation_rules.mjs",
    "analyze:duplicates": "node scripts/analyze_duplicates.mjs",
    "clean:translations": "node scripts/clean_translations.mjs",
    "inspect:csd": "node scripts/inspect_csd.mjs",
    "crawl:unique-bases": "node scripts/crawl_unique_bases.mjs"
  }
}
